{
  "name": "jungle-backend-challenge",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "packageManager": "bun@1.4.3",
  "engines": {
    "bun": ">=1.4.3 <2"
  },
  "mikro-orm": {
    "configPaths": [
      "./dist/mikro-orm.config.js"
    ]
  },
  "scripts": {
    "start:dev": "bun --watch src/main.ts",
    "typecheck": "tsc -p tsconfig.typecheck.json",
    "build": "tsc -p tsconfig.json",
    "start": "bun dist/main.js",
    "test": "bun test",
    "db:migration:create": "mikro-orm migration:create",
    "db:migration:up": "mikro-orm migration:up",
    "db:migration:down": "mikro-orm migration:down",
    "sqs:provision": "bun src/infrastructure/messaging/provision-sqs.ts"
  },
  "dependencies": {
    "@aws-sdk/client-sqs": "^3.1152.0",
    "@mikro-orm/core": "^7.2.5",
    "@mikro-orm/migrations": "^7.2.5",
    "@mikro-orm/nestjs": "^7.1.0",
    "@mikro-orm/postgresql": "^7.2.5",
    "@nestjs/common": "12.1.3",
    "@nestjs/core": "12.1.3",
    "@nestjs/platform-express": "12.1.3",
    "decimal.js": "10.6.0",
    "reflect-metadata": "0.2.2",
    "rxjs": "7.8.2"
  },
  "devDependencies": {
    "@mikro-orm/cli": "^7.2.5",
    "@types/bun": "^1.4.3",
    "typescript": "5.9.3"
  }
}
